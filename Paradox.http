@baseUrl = http://localhost:10000
@quizKey = replace-with-private-key
@privateTemplateKey = replace-with-private-template-key

### Create a quiz
POST {{baseUrl}}/api/games
Content-Type: application/json

{
  "quizName": "Quick Science",
  "description": "A quick round of science trivia!",
  "theme": "ocean",
  "mode": "Quiz",
  "subjectWheelEnabled": true,
  "questions": [
    {
      "prompt": "Which planet is known as the Red Planet?",
      "subject": "Space",
      "options": ["Venus", "Mars", "Jupiter", "Mercury"],
      "correctOptionIndex": 1,
      "timeLimitSeconds": 20
    }
  ]
}

### List the available quiz themes
GET {{baseUrl}}/api/library/themes

### Save a reusable quiz (first save returns a private owner key)
POST {{baseUrl}}/api/library/
Content-Type: application/json

{
  "quizName": "Space night",
  "description": "A quick round among the stars.",
  "theme": "sunset",
  "questions": [
    {
      "prompt": "Which planet has the most visible rings?",
      "options": ["Mars", "Saturn"],
      "correctOptionIndex": 1,
      "timeLimitSeconds": 20
    }
  ]
}

### List quizzes belonging to the owner key
GET {{baseUrl}}/api/library/
X-Quiz-Key: {{quizKey}}

### Read, edit, or delete a quiz (replace {id} with its saved ID)
GET {{baseUrl}}/api/library/{id}
X-Quiz-Key: {{quizKey}}

###
PUT {{baseUrl}}/api/library/{id}
X-Quiz-Key: {{quizKey}}
Content-Type: application/json

{
  "quizName": "Space night — updated",
  "description": "A quick round among the stars.",
  "theme": "violet",
  "questions": [
    {
      "prompt": "Which planet has the most visible rings?",
      "options": ["Mars", "Saturn"],
      "correctOptionIndex": 1,
      "timeLimitSeconds": 30
    }
  ]
}

###
DELETE {{baseUrl}}/api/library/{id}
X-Quiz-Key: {{quizKey}}

### Read a game snapshot (replace 123456 with the returned PIN)
GET {{baseUrl}}/api/games/123456

### Join the lobby
POST {{baseUrl}}/api/games/123456/players
Content-Type: application/json

{
  "username": "Alex"
}

### Mark a player disconnected (the player ID is restored on page refresh)
POST {{baseUrl}}/api/games/123456/players/disconnect
Content-Type: application/json

{
  "playerId": "replace-with-player-id"
}

### Leave the game and remove the player immediately
POST {{baseUrl}}/api/games/123456/players/leave
Content-Type: application/json

{
  "playerId": "replace-with-player-id"
}

### Kick a player from the game (include the host key)
POST {{baseUrl}}/api/games/123456/players/kick
X-Host-Key: replace-with-host-key
Content-Type: application/json

{
  "username": "Alex"
}

### Skip the active board-game player's turn (include the host key)
POST {{baseUrl}}/api/games/123456/skip-turn
X-Host-Key: replace-with-host-key

### Start the game (include the X-Host-Key returned by create)
POST {{baseUrl}}/api/games/123456/start
X-Host-Key: replace-with-host-key

### Submit an answer (include the X-Player-Id returned by join)
POST {{baseUrl}}/api/games/123456/answers
X-Player-Id: replace-with-player-id
Content-Type: application/json

{
  "optionIndex": 1
}

### Continue after the answer reveal (include the host key)
POST {{baseUrl}}/api/games/123456/next
X-Host-Key: replace-with-host-key

### Spin the subject wheel at random (or set "subject" to pick manually)
POST {{baseUrl}}/api/games/123456/wheel/spin
X-Host-Key: replace-with-host-key
Content-Type: application/json

{
  "subject": null
}

### Create a digital board game
POST {{baseUrl}}/api/games
Content-Type: application/json

{
  "quizName": "Science Adventure",
  "theme": "ocean",
  "mode": "Board",
  "questions": [
    {
      "prompt": "Which planet is known as the Red Planet?",
      "subject": "Space",
      "options": ["Venus", "Mars"],
      "correctOptionIndex": 1,
      "timeLimitSeconds": 20
    }
  ],
  "boardTiles": [
    { "action": "Start", "amount": 0 },
    { "action": "Question", "subject": "Space" },
    { "action": "Bonus", "amount": 100 },
    { "action": "Question", "subject": "Space" }
  ]
}

### Roll during the active player's board turn
POST {{baseUrl}}/api/games/123456/board/roll
X-Player-Id: replace-with-active-player-id

### Load the private family template (uses Render-configured private settings)
GET {{baseUrl}}/api/private/family-show
X-Private-Template-Key: {{privateTemplateKey}}

### Submit the current answer list during Smash the Answer
POST {{baseUrl}}/api/games/123456/smash/answers
X-Player-Id: replace-with-player-id
Content-Type: application/json

{
  "answers": ["Apple", "Banana", "Orange"]
}
